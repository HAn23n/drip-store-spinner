# Supabase project settings (Dashboard → Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# service_role key — server-only, used by API routes to write. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Password required to open /admin (the wheel-editing page)
ADMIN_PASSWORD=change-me

# Random long string used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=change-me-too
